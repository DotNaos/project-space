{
  "name": "Project Space Codespace Runner",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm@sha256:7f9160225f2e0af7a3531a925358ffebff77e1d03d1628953e4252efd6e7bf2d",
  "remoteUser": "node",
  "remoteEnv": {
    "PATH": "/home/node/.local/bin:/home/node/.bun/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "DotNaos/project-space": {
          "permissions": {
            "contents": "write",
            "issues": "write",
            "pull_requests": "write",
            "workflows": "write"
          }
        }
      }
    }
  },
  "onCreateCommand": "bash .devcontainer/bootstrap.sh",
  "postCreateCommand": "bash .devcontainer/start-runner.sh",
  "postStartCommand": "bash .devcontainer/start-runner.sh"
}
