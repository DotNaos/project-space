{
  "name": "Project Space",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.15.0",
      "nodeGypDependencies": true,
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.97.0"
    },
    "ghcr.io/devcontainers-extra/features/tmux-apt-get:1.0.17": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/python",
    "ghcr.io/devcontainers/features/node"
  ],
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.bun/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/bootstrap.sh && bash .devcontainer/bootstrap.sh",
  "postStartCommand": "bash .devcontainer/start-services.sh",
  "forwardPorts": [
    4173,
    45873,
    5180
  ]
}
