{
  "name": "Project Space Codespace Runner",
  "image": "mcr.microsoft.com/devcontainers/universal:6.1.1-linux@sha256:cb1ccdf5e3c10b4134ffe8f2c03e8481e7c41058d27a70192fa54146a8c327c2",
  "remoteUser": "codespace",
  "remoteEnv": {
    "PATH": "/home/codespace/.local/bin:/home/codespace/.bun/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "DotNaos/project-space": {
          "permissions": {
            "contents": "write",
            "issues": "write",
            "pull_requests": "write",
            "workflows": "write"
          }
        }
      }
    }
  },
  "onCreateCommand": "bash .devcontainer/bootstrap.sh",
  "postCreateCommand": "bash .devcontainer/start-runner.sh",
  "postStartCommand": "bash .devcontainer/start-runner.sh"
}
