#!/usr/bin/expect -f
set timeout 180
log_user 0

foreach name {MQTT_CLIENT_PASSWORD MQTT_CLIENT_USERNAME REMOTE_SCRIPT_PATH} {
  if {![info exists env($name)] || $env($name) eq ""} {
    puts stderr "missing required environment variable $name"
    exit 64
  }
}

set username $env(MQTT_CLIENT_USERNAME)
if {[string length $username] > 128 ||
    [regexp {[^A-Za-z0-9._-]} $username] ||
    !([string match "project-space-jetkvm-?*" $username] ||
      [string match "jetkvm-?*" $username])} {
  puts stderr "invalid MQTT client username"
  exit 64
}

spawn ssh -tt deploy@100.84.238.75 \
  sudo -n sh $env(REMOTE_SCRIPT_PATH) $username

set prompt_count 0
set update_confirmed 0
set transcript ""
expect {
  -re {updated MQTT client: [A-Za-z0-9._-]+} {
    append transcript $expect_out(buffer)
    set update_confirmed 1
    exp_continue
  }
  -re {Reenter password:} {
    append transcript $expect_out(buffer)
    incr prompt_count
    send -- "$env(MQTT_CLIENT_PASSWORD)\r"
    exp_continue
  }
  -re {Password:} {
    append transcript $expect_out(buffer)
    incr prompt_count
    send -- "$env(MQTT_CLIENT_PASSWORD)\r"
    exp_continue
  }
  eof {
    append transcript $expect_out(buffer)
  }
}

catch wait result
if {[lindex $result 3] != 0 || $prompt_count != 2 || !$update_confirmed} {
  puts stderr [string map [list $env(MQTT_CLIENT_PASSWORD) {[redacted]}] $transcript]
  exit 70
}
exit 0
