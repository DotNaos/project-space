#!/usr/bin/expect -f
set timeout 180
log_user 0

foreach name {PROJECT_PROVIDER_PASSWORD JETKVM_PASSWORD REMOTE_SCRIPT_PATH} {
  if {![info exists env($name)] || $env($name) eq ""} {
    puts stderr "missing required environment variable $name"
    exit 64
  }
}

set remote_script_path $env(REMOTE_SCRIPT_PATH)
if {$remote_script_path eq ""} {
  puts stderr "missing required environment variable REMOTE_SCRIPT_PATH"
  exit 64
}

spawn ssh -tt deploy@100.84.238.75 sudo -n sh $remote_script_path

set password_index 0
expect {
  -re {Reenter password:} {
    if {![info exists current_password]} {
      exit 70
    }
    send -- "$current_password\r"
    unset current_password
    exp_continue
  }
  -re {Password:} {
    if {$password_index == 0} {
      set current_password $env(PROJECT_PROVIDER_PASSWORD)
    } elseif {$password_index == 1} {
      set current_password $env(JETKVM_PASSWORD)
    } else {
      exit 71
    }
    incr password_index
    send -- "$current_password\r"
    exp_continue
  }
  eof
}

catch wait result
exit [lindex $result 3]
