{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "apps/prototype/vite.config.ts",
    "apps/prototype/src/project-space-pages/machine-runtime-fixtures.ts",
    "apps/docs/lib/releases/catalog.ts",
    "apps/docs/lib/releases/changelog-source.ts",
    "apps/docs/lib/releases/frontmatter.ts",
    "apps/docs/lib/releases/mdx.ts",
    "apps/docs/lib/releases/semver.ts",
    "apps/docs/lib/releases/types.ts",
    "scripts/dev-prototype.ts",
    "server",
    "src/shared"
  ]
}
