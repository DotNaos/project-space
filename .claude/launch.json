{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "frontend-local-connector",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_PROJECT_SPACE_API_BASE_URL=http://127.0.0.1:4173 pnpm exec vite --host 127.0.0.1 --port 5174"
      ],
      "port": 5174
    }
  ]
}
