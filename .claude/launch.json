{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "frontend-local-connector",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_PROJECT_SPACE_API_BASE_URL=http://127.0.0.1:4173 bunx vite --host 127.0.0.1 --port 5174"
      ],
      "port": 5174
    },
    {
      "name": "frontend-noauth-embedded",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PROJECT_SPACE_AUTH_DISABLED=1 VITE_PROJECT_SPACE_AUTH_DISABLED=1 bunx vite --host 127.0.0.1 --port ${PORT:-5176}"
      ],
      "port": 5176,
      "autoPort": true
    },
    {
      "name": "frontend-preview-noauth",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_PROJECT_SPACE_AUTH_DISABLED=1 VITE_PROJECT_SPACE_API_BASE_URL=http://127.0.0.1:4174 bunx vite --host 127.0.0.1 --port ${PORT:-5175}"
      ],
      "port": 5175,
      "autoPort": true
    },
    {
      "name": "frontend-direct",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "./node_modules/.bin/vite --host 127.0.0.1 --port ${PORT:-5178}"
      ],
      "port": 5178,
      "autoPort": true
    },
    {
      "name": "frontend-noauth-direct",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PROJECT_SPACE_AUTH_DISABLED=1 VITE_PROJECT_SPACE_AUTH_DISABLED=1 ./node_modules/.bin/vite --host 127.0.0.1 --port ${PORT:-5177}"
      ],
      "port": 5177,
      "autoPort": true
    }
  ]
}
