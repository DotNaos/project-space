{
  "name": "project-space",
  "version": "0.4.66",
  "private": true,
  "description": "Desktop-first workspace management foundation for project-centered workflows.",
  "type": "module",
  "bin": {
    "project": "./bin/project"
  },
  "scripts": {
    "dev": "portless run vite --host 127.0.0.1",
    "dev:prototype": "portless run bun scripts/dev-prototype.ts",
    "dev:prototype:direct": "PROJECT_SPACE_ALLOW_DIRECT_DEV=1 PORT=5180 bun scripts/dev-prototype.ts",
    "serve:prototype:desktop": "PROJECT_SPACE_ALLOW_DIRECT_DEV=1 vite --config apps/prototype/vite.config.ts",
    "dev:direct": "PROJECT_SPACE_ALLOW_DIRECT_DEV=1 vite --host 127.0.0.1",
    "build": "bun scripts/build-project.ts",
    "build:web": "tsc -b && vite build && vite build --config apps/prototype/vite.config.ts",
    "build:prototype": "tsc -b && vite build --config apps/prototype/vite.config.ts && cd apps/mobile && bun install --frozen-lockfile && bun run build:prototype",
    "test": "bun test --isolate",
    "build:connector:native": "bun packaging/release/build-connector.ts bun dist/project-space-connector",
    "build:connector:macos-arm64": "bun packaging/release/build-connector.ts bun-darwin-arm64 dist/project-space-connector",
    "build:connector:windows-x64": "bun packaging/release/build-connector.ts bun-windows-x64 dist/windows/project-space-connector.exe",
    "build:project-cli:macos-arm64": "mkdir -p dist && build_sha=${GITHUB_SHA:-$(git rev-parse HEAD)} && CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags=\"-s -w -X main.projectMachineClientVersion=$npm_package_version -X main.projectMachineClientReleaseID=v$npm_package_version -X main.projectMachineClientBuildID=$build_sha\" -o dist/project ./cmd/project",
    "build:machine-tools:macos-arm64": "bun run build:connector:macos-arm64 && bun run build:project-cli:macos-arm64 && packaging/macos/build-machine-tools.sh \"$npm_package_version\" dist dist/macos-release",
    "docs:build": "cd apps/docs && bun run build",
    "ci:preflight": "bun scripts/ci-preflight.ts",
    "ci:inventory:open-prs": "bun scripts/report-open-pr-ci.ts",
    "docs:release:check": "bun scripts/validate-release-pr.ts --catalog",
    "docs:release:pr": "bun scripts/validate-release-pr.ts",
    "docs:cli:check": "bun scripts/generate-cli-docs.ts --check",
    "docs:cli:generate": "bun scripts/generate-cli-docs.ts",
    "machine-power:mqtt-acl:check": "bun scripts/generate-machine-power-mqtt-acl.ts --check",
    "machine-power:mqtt-acl:generate": "bun scripts/generate-machine-power-mqtt-acl.ts",
    "machine-power:mqtt-isolation:test": "bun scripts/test-machine-power-mqtt-isolation.ts",
    "jetkvm:provision": "bun scripts/jetkvm-provisioning.ts",
    "docs:dev": "cd apps/docs && bun run dev",
    "docs:typecheck": "cd apps/docs && bun run typecheck",
    "check": "bun run check:package-manager && tsc -b",
    "check:package-manager": "bun scripts/check-package-manager.ts",
    "check:cli": "go test ./...",
    "connector:serve": "tailscale serve --bg --yes 4173",
    "connector:status": "tailscale serve status --json",
    "connector:start": "bun server/web-server.ts",
    "dev:connector": "VITE_PROJECT_SPACE_API_BASE_URL=http://127.0.0.1:45873 portless run vite --host 127.0.0.1",
    "preview": "vite preview",
    "start": "bun server/web-server.ts",
    "start:preview-gateway": "bun server/preview-gateway.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.9.0",
    "@clerk/react": "^6.11.3",
    "@dotnaos/react-ui": "^0.0.2",
    "@heroui/react": "3.0.4",
    "@heroui/styles": "3.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@wterm/dom": "^0.3.0",
    "@xyflow/react": "^12.11.2",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "mqtt": "5.14.1",
    "node-pty": "^1.1.0",
    "pg": "^8.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  },
  "packageManager": "bun@1.3.14"
}
