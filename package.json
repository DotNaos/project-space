{
  "name": "project-space",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop-first workspace management foundation for project-centered workflows.",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "bin": {
    "project": "./bin/project"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "vite --mode electron --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "bun test",
    "build:connector:native": "bun build --compile server/web-server.ts --outfile dist/project-space-connector",
    "build:connector:macos-arm64": "bun build --compile --target=bun-darwin-arm64 server/web-server.ts --outfile dist/project-space-connector",
    "build:connector:windows-x64": "bun build --compile --target=bun-windows-x64 server/web-server.ts --outfile dist/windows/project-space-connector.exe",
    "build:project-cli:macos-arm64": "mkdir -p dist && CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags='-s -w' -o dist/project ./cmd/project",
    "build:machine-tools:macos-arm64": "bun run build:connector:macos-arm64 && bun run build:project-cli:macos-arm64 && COPYFILE_DISABLE=1 tar -czf dist/project-space-machine-tools-darwin-arm64.tar.gz -C dist project-space-connector project",
    "docs:build": "cd apps/docs && bun run build",
    "docs:dev": "cd apps/docs && bun run dev",
    "docs:typecheck": "cd apps/docs && bun run typecheck",
    "build:electron": "tsc -b && vite build --mode electron",
    "check": "tsc -b",
    "check:cli": "go test ./...",
    "connector:serve": "tailscale serve --bg --yes 4173",
    "connector:status": "tailscale serve status --json",
    "connector:start": "bun server/web-server.ts",
    "dev:connector": "VITE_PROJECT_SPACE_API_BASE_URL=http://127.0.0.1:45873 vite --host 127.0.0.1",
    "preview": "vite preview",
    "start": "bun server/web-server.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.9.0",
    "@clerk/react": "^6.11.3",
    "@dotnaos/react-ui": "^0.0.2",
    "@wterm/dom": "^0.3.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "node-pty": "^1.1.0",
    "pg": "^8.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "react-devtools-core": "^7.0.1",
    "react-devtools-electron": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
